# Application
APP_NAME="Fleet Management API"
ENVIRONMENT=development
DEBUG=true

# Database
# Local development (default): SQLite
DATABASE_URL=sqlite:///./fleet.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://fleet_user:CHANGE_ME@localhost:5432/fleet

# Security - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (comma separated, "*" allows all)
CORS_ORIGINS=*

# Business rules
MAINTENANCE_DUE_WINDOW_DAYS=14
DOCUMENT_EXPIRY_WINDOW_DAYS=30
